#pragma kernel CutSDF
#pragma kernel CopySDF

RWTexture3D<float> SDFTexture;

// For copying
Texture3D<float> SourceSDF;
SamplerState sampler_SourceSDF;
RWTexture3D<float> DestSDF;

// Parameters for cutting - to resolve issue number 4 (parameter mismatch)
int3 Dims; // Changed from uint3 to int3 to match C# SetInts
float3 CutCenter;
float CutRadius;
float CutDepth;
float3 CutDirection;

[numthreads(8, 8, 8)]
void CutSDF(uint3 id: SV_DispatchThreadID)
{
    // Use the passed dimensions instead of getting from texture - to resolve issue number 4
    if (id.x >= Dims.x || id.y >= Dims.y || id.z >= Dims.z)
        return;
    
    // Convert texture coordinates to normalized space (0-1) - to resolve issue number 1
    float3 texturePos = (float3(id) + 0.5) / float3(Dims);
    
    // Calculate distance from cut center in texture space
    float distanceToCenter = length(texturePos - CutCenter);
    
    // Check if this voxel is within the cutting radius
    if (distanceToCenter <= CutRadius)
    {
        // Calculate how much to cut based on distance from center
        float cutStrength = 1.0 - (distanceToCenter / CutRadius);
        cutStrength = smoothstep(0.0, 1.0, cutStrength);
        
        // Apply the cut - to resolve issue number 9 (SDF direction)
        float currentSDF = SDFTexture[id];
        float cutAmount = CutDepth * cutStrength * 0.005f; // Further reduced for more controlled cutting
        
        // For cutting, we want to make the SDF more positive (further from surface)
        // This creates a "hole" in the surface
        SDFTexture[id] = currentSDF + cutAmount; // Changed from subtraction to addition for proper cutting
    }
}

[numthreads(8, 8, 8)]
void CopySDF(uint3 id: SV_DispatchThreadID)
{
    if (id.x >= Dims.x || id.y >= Dims.y || id.z >= Dims.z)
        return;
    
    // Copy SDF value from source to destination
    float3 uv = (float3(id) + 0.5) / float3(Dims);
    float sdfValue = SourceSDF.SampleLevel(sampler_SourceSDF, uv, 0);
    DestSDF[id] = sdfValue;
}
